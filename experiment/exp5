<!DOCTYPE html>
<html>
<head>
    <title>Cart Calculator</title>
</head>
<body>

<h2>Shopping Cart</h2>

<button onclick="calculateTotal()">Calculate Total</button>

<p id="result"></p>

<script>

    // Array of objects
    const cart = [
        { name: "Shirt", price: 800, quantity: 2 },
        { name: "Shoes", price: 1500, quantity: 1 },
        { name: "Cap", price: 300, quantity: 2 }
    ];

    function calculateTotal() {

        // map() calculates price of each item
        const itemTotals = cart.map(function(item) {
            return item.price * item.quantity;
        });

        // reduce() calculates total
        let total = itemTotals.reduce(function(sum, value) {
            return sum + value;
        }, 0);

        let discount = 0;

        // Discount logic
        if (total >= 3000) {
            discount = total * 0.10;
        } else if (total >= 2000) {
            discount = total * 0.05;
        }

        let finalAmount = total - discount;

        document.getElementById("result").innerHTML =
            "Total: ₹" + total +
            "<br>Discount: ₹" + discount +
            "<br>Final Amount: ₹" + finalAmount;
    }

</script>

</body>
</html>
